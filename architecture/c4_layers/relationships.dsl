# ===== PESSOAS =====
gestao -> maqControl.app "Administra cadastros e planos, acompanha indicadores e pede relatórios" "HTTPS" "sync"
operacao -> maqControl.app "Abre e executa ordens de serviço e registra apontamentos" "HTTPS" "sync"
consulta -> maqControl.app "Consulta dados e conversa com o assistente de IA" "HTTPS" "sync"

# ===== CONTAINERS =====
maqControl.app -> maqControl.backend "Chama a API REST, o assistente e os relatórios" "HTTPS/JSON" "sync"
maqControl.backend -> maqControl.db "Lê e escreve dados" "Prisma/SQL" "sync"
maqControl.backend -> maqControl.reportStorage "Grava e recupera os relatórios" "HTTPS" "sync"
maqControl.backend -> llmProvider "Envia prompts e recebe respostas" "HTTPS" "sync"
maqControl.backend -> jobQueueService "Publica os jobs de relatório" "HTTPS" "async"
jobQueueService -> maqControl.backend "Chama de volta para processar o relatório" "HTTPS" "async"

# ===== C3 FRONTEND =====
maqControl.app.rootLayout -> maqControl.app.protectedGuard "Envolve as rotas autenticadas" "expo-router" "sync"
maqControl.app.protectedGuard -> maqControl.app.authStore "Verifica a sessão" "Zustand" "sync"
maqControl.app.loginScreen -> maqControl.app.authStore "Salva token e perfil após o login" "Zustand" "sync"
maqControl.app.loginScreen -> maqControl.app.featureHooks "Chama o login" "React" "sync"
maqControl.app.dashboardScreen -> maqControl.app.featureHooks "Busca indicadores" "React" "sync"
maqControl.app.osScreen -> maqControl.app.featureHooks "Busca e envia ordens de serviço" "React" "sync"
maqControl.app.ativosScreen -> maqControl.app.featureHooks "Busca e envia ativos e paradas" "React" "sync"
maqControl.app.cadastrosScreen -> maqControl.app.featureHooks "Busca e envia cadastros" "React" "sync"
maqControl.app.assistenteScreen -> maqControl.app.featureHooks "Envia as mensagens do assistente" "React" "sync"
maqControl.app.relatoriosScreen -> maqControl.app.featureHooks "Solicita e acompanha relatórios" "React" "sync"
maqControl.app.featureHooks -> maqControl.app.apiClient "Fazem as requisições" "TanStack Query" "sync"
maqControl.app.apiClient -> maqControl.app.authStore "Lê o token e limpa a sessão no 401" "Zustand" "sync"
maqControl.app.apiClient -> maqControl.app.tokenStorage "Lê e grava o token" "expo-secure-store" "sync"
maqControl.app.apiClient -> maqControl.backend "Envia requisições para /api" "HTTPS/REST" "sync"

# ===== C3 BACKEND (DOMÍNIO) =====
maqControl.backend.authMiddleware -> maqControl.backend.tokenService "Valida o token" "TypeScript" "sync"
maqControl.backend.authController -> maqControl.backend.authService "Delega login, cadastro e troca de senha" "TypeScript" "sync"
maqControl.backend.authService -> maqControl.backend.tokenService "Gera e revoga tokens" "TypeScript" "sync"
maqControl.backend.authService -> maqControl.backend.authRepository "Lê e grava usuários" "Prisma" "sync"
maqControl.backend.authRepository -> maqControl.backend.prismaClient "Persiste via Prisma" "Prisma" "sync"

maqControl.backend.osController -> maqControl.backend.osService "Delega as operações da OS" "TypeScript" "sync"
maqControl.backend.osService -> maqControl.backend.osWorkflow "Aplica as transições de estado" "TypeScript" "sync"
maqControl.backend.osService -> maqControl.backend.osRepository "Lê e grava a OS" "Prisma" "sync"
maqControl.backend.osWorkflow -> maqControl.backend.osRepository "Atualiza parada, ativo e tempos na transação" "Prisma" "sync"
maqControl.backend.osService -> maqControl.backend.alertasModule "Gera alertas de parada e atraso" "TypeScript" "sync"
maqControl.backend.osRepository -> maqControl.backend.prismaClient "Persiste via Prisma" "Prisma" "sync"

maqControl.backend.ativosModule -> maqControl.backend.alertasModule "Gera alerta de ativo parado" "TypeScript" "sync"
maqControl.backend.paradasModule -> maqControl.backend.alertasModule "Gera alerta de parada" "TypeScript" "sync"
maqControl.backend.materiaisModule -> maqControl.backend.alertasModule "Gera alerta de estoque baixo" "TypeScript" "sync"
maqControl.backend.planosModule -> maqControl.backend.osService "Programa ordens preventivas" "TypeScript" "sync"

maqControl.backend.ativosModule -> maqControl.backend.prismaClient "Lê e escreve via Prisma" "Prisma" "sync"
maqControl.backend.localizacoesModule -> maqControl.backend.prismaClient "Lê e escreve via Prisma" "Prisma" "sync"
maqControl.backend.paradasModule -> maqControl.backend.prismaClient "Lê e escreve via Prisma" "Prisma" "sync"
maqControl.backend.apontamentosModule -> maqControl.backend.prismaClient "Lê e escreve via Prisma" "Prisma" "sync"
maqControl.backend.osMateriaisModule -> maqControl.backend.prismaClient "Lê e escreve via Prisma" "Prisma" "sync"
maqControl.backend.materiaisModule -> maqControl.backend.prismaClient "Lê e escreve via Prisma" "Prisma" "sync"
maqControl.backend.planosModule -> maqControl.backend.prismaClient "Lê e escreve via Prisma" "Prisma" "sync"
maqControl.backend.alertasModule -> maqControl.backend.prismaClient "Lê e escreve via Prisma" "Prisma" "sync"
maqControl.backend.dashboardModule -> maqControl.backend.prismaClient "Agrega via Prisma" "Prisma" "sync"
maqControl.backend.auditoriaModule -> maqControl.backend.prismaClient "Lê via Prisma" "Prisma" "sync"
maqControl.backend.empresasModule -> maqControl.backend.prismaClient "Lê e escreve via Prisma" "Prisma" "sync"
maqControl.backend.usuariosModule -> maqControl.backend.prismaClient "Lê e escreve via Prisma" "Prisma" "sync"
maqControl.backend.auditMiddleware -> maqControl.backend.prismaClient "Grava o log de auditoria" "Prisma" "async"
maqControl.backend.prismaClient -> maqControl.db "Lê e escreve dados" "SQL" "sync"

# ===== C3 CAMADA DE IA =====
maqControl.app.apiClient -> maqControl.backend.chatController "Envia mensagens do assistente" "HTTPS/REST" "sync"
maqControl.app.apiClient -> maqControl.backend.reportController "Solicita e baixa relatórios" "HTTPS/REST" "sync"
maqControl.app.apiClient -> maqControl.backend.troubleshootController "Pede sugestões de diagnóstico" "HTTPS/REST" "sync"

maqControl.backend.chatController -> maqControl.backend.chatService "Delega a conversa" "TypeScript" "sync"
maqControl.backend.chatService -> maqControl.backend.conversationRepo "Lê e grava o histórico" "Prisma" "sync"
maqControl.backend.chatService -> maqControl.backend.orchestrator "Processa a mensagem" "TypeScript" "sync"
maqControl.backend.orchestrator -> maqControl.backend.intentClassifier "Classifica a intenção" "TypeScript" "sync"
maqControl.backend.orchestrator -> maqControl.backend.queryAgent "Delega perguntas de dados" "TypeScript" "sync"
maqControl.backend.orchestrator -> maqControl.backend.reportJobService "Enfileira a geração de relatório" "TypeScript" "async"

maqControl.backend.queryAgent -> maqControl.backend.relevantViews "Seleciona as views relevantes" "TypeScript" "sync"
maqControl.backend.queryAgent -> maqControl.backend.schemaContext "Monta o contexto do schema" "TypeScript" "sync"
maqControl.backend.queryAgent -> maqControl.backend.queryGeneration "Gera o SQL" "TypeScript" "sync"
maqControl.backend.queryGeneration -> maqControl.backend.sqlValidator "Valida o SQL gerado" "TypeScript" "sync"
maqControl.backend.queryAgent -> maqControl.backend.queryExecutor "Executa a consulta" "TypeScript" "sync"
maqControl.backend.queryAgent -> maqControl.backend.queryAnswer "Redige a resposta" "TypeScript" "sync"
maqControl.backend.queryExecutor -> maqControl.db "Executa SELECT com role somente leitura" "SQL" "sync"

maqControl.backend.reportController -> maqControl.backend.reportJobService "Cria o job de relatório" "TypeScript" "sync"
maqControl.backend.reportJobService -> maqControl.backend.reportRepo "Registra o job e o status" "Prisma" "sync"
maqControl.backend.reportJobService -> maqControl.backend.qstashDispatcher "Publica o job" "TypeScript" "async"
maqControl.backend.qstashDispatcher -> jobQueueService "Publica o job (HTTPS)" "HTTPS" "async"
jobQueueService -> maqControl.backend.qstashCallback "Chama de volta quando o job dispara" "HTTPS" "async"
maqControl.backend.qstashCallback -> maqControl.backend.reportProcessor "Dispara o processamento" "TypeScript" "sync"
maqControl.backend.reportProcessor -> maqControl.backend.reportAgent "Gera o conteúdo do relatório" "TypeScript" "sync"
maqControl.backend.reportAgent -> maqControl.backend.queryAgent "Reaproveita as consultas de dados" "TypeScript" "sync"
maqControl.backend.reportProcessor -> maqControl.backend.reportRenderer "Gera o PDF" "TypeScript" "sync"
maqControl.backend.reportProcessor -> maqControl.backend.reportStorageAdapter "Grava o PDF" "TypeScript" "sync"
maqControl.backend.reportProcessor -> maqControl.backend.reportRepo "Atualiza status e metadados" "Prisma" "sync"
maqControl.backend.reportStorageAdapter -> maqControl.reportStorage "Grava e recupera o PDF" "HTTPS" "sync"

maqControl.backend.troubleshootController -> maqControl.backend.troubleshootAgent "Delega o diagnóstico" "TypeScript" "sync"
maqControl.backend.troubleshootAgent -> maqControl.db "Lê o histórico de falhas" "SQL" "sync"

maqControl.backend.conversationRepo -> maqControl.db "Persiste conversas via Prisma" "SQL" "sync"
maqControl.backend.reportRepo -> maqControl.db "Persiste relatórios via Prisma" "SQL" "sync"

maqControl.backend.intentClassifier -> maqControl.backend.groqProvider "Chamada ao modelo" "TypeScript" "sync"
maqControl.backend.queryGeneration -> maqControl.backend.groqProvider "Chamada ao modelo" "TypeScript" "sync"
maqControl.backend.queryAnswer -> maqControl.backend.groqProvider "Chamada ao modelo" "TypeScript" "sync"
maqControl.backend.reportAgent -> maqControl.backend.groqProvider "Chamada ao modelo" "TypeScript" "sync"
maqControl.backend.troubleshootAgent -> maqControl.backend.groqProvider "Chamada ao modelo" "TypeScript" "sync"
maqControl.backend.groqProvider -> llmProvider "Envia prompts (HTTPS)" "HTTPS" "sync"
