# Ambiente
NODE_ENV=development

# Servidor
PORT=3333

# Banco de dados PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ctrpe?schema=public"

# JWT
JWT_SECRET="troque-esta-chave-em-producao"
JWT_EXPIRES_IN="1d"

# Bcrypt
BCRYPT_SALT_ROUNDS=10

# CORS (descomente e ajuste para produção)
# CORS_ORIGIN="http://localhost:8081"

# Google reCAPTCHA Enterprise
GOOGLE_CLOUD_PROJECT_ID="project-id"
RECAPTCHA_WEB_SITE_KEY="chavve-web"
RECAPTCHA_ANDROID_SITE_KEY="chave-android"
RECAPTCHA_IOS_SITE_KEY="chave-ios"
RECAPTCHA_MIN_SCORE=0.5

# Banco de dados — role SOMENTE LEITURA da camada de IA (agente de consulta)
# Usuário fixo: ctrpe_ai_readonly (criado pela migration, sem senha).
# Escolha uma senha forte aqui e rode `npm run ai-role:set-password` para aplicá-la.
# Neon: use o mesmo host/banco do DATABASE_URL e mantenha ?sslmode=require.
# Este role só enxerga as views do schema "ai"; nunca use o DATABASE_URL para o agente.
AI_READONLY_DATABASE_URL="postgresql://ctrpe_ai_readonly:troque-esta-senha@localhost:5432/ctrpe"
