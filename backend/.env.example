# Ambiente
NODE_ENV=development

# Servidor
PORT=3333

# Banco de dados PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ctrpe?schema=public"

# JWT
JWT_SECRET="troque-esta-chave-em-producao"
JWT_EXPIRES_IN="1d"

# Bcrypt
BCRYPT_SALT_ROUNDS=10

# CORS (descomente e ajuste para produção)
# CORS_ORIGIN="http://localhost:8081"

# Google reCAPTCHA Enterprise
GOOGLE_CLOUD_PROJECT_ID="project-id"
RECAPTCHA_WEB_SITE_KEY="chavve-web"
RECAPTCHA_ANDROID_SITE_KEY="chave-android"
RECAPTCHA_IOS_SITE_KEY="chave-ios"
RECAPTCHA_MIN_SCORE=0.5