# Ambiente
NODE_ENV=development

# Servidor
PORT=3333

# Banco de dados PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ctrpe?schema=public"
# Conexão exclusiva da IA, com a role ctrpe_ai_readonly
AI_READONLY_DATABASE_URL="postgresql://ctrpe_ai_readonly:troque-a-senha@localhost:5432/ctrpe?schema=ai"

# JWT
JWT_SECRET="troque-esta-chave-em-producao"
JWT_EXPIRES_IN="1d"

# Bcrypt
BCRYPT_SALT_ROUNDS=10

# CORS (descomente e ajuste para produção)
# CORS_ORIGIN="http://localhost:8081"

# Google reCAPTCHA Enterprise
GOOGLE_CLOUD_PROJECT_ID=""
GOOGLE_APPLICATION_CREDENTIALS=""
RECAPTCHA_WEB_SITE_KEY=""
RECAPTCHA_ANDROID_SITE_KEY=""
RECAPTCHA_IOS_SITE_KEY=""
RECAPTCHA_MIN_SCORE=0.5

# Provedor de IA (nunca versione uma chave real)
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
AI_LLM_TIMEOUT_MS=30000
GROQ_ORCHESTRATOR_MODEL=openai/gpt-oss-20b

# Storage privado de relatórios no Vercel Blob
BLOB_READ_WRITE_TOKEN=""
