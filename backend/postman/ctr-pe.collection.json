              "host": ["{{baseUrl}}"],
              "path": ["api", "ordens-servico", "1"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Regra de Negócio: PATCH genérico não deve aceitar alteração arbitrária de status', function () {",
                  "    pm.expect([400, 422]).to.include(pm.response.code);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "PATCH /api/ordens-servico/:id/iniciar - Transição de Fluxo Válida",
