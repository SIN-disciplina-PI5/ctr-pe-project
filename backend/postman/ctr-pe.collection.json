    {
      "name": "03. Ordens de Servico Router",
      "item": [
        {
          "name": "GET /api/ordens-servico - Listar Ordens (Autenticado)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_admin}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/ordens-servico",
              "host": ["{{baseUrl}}"],
              "path": ["api", "ordens-servico"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code é 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Resposta retorna array ou objeto paginado', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(Array.isArray(json) || Array.isArray(json.data) || Array.isArray(json.ordens)).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "PATCH /api/ordens-servico/:id - Tentativa de Mudar Status Diretamente (Security/Business Rule Gap)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_admin}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"CONCLUIDA\"\n}"
            },
            "url": {
