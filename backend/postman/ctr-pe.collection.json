        {
          "name": "POST /api/auth/sign-up-testing - Brecha de Segurança Conhecida (Security Gap)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Exploit User\",\n  \"email\": \"exploit@teste.com\",\n  \"senha\": \"Exploit@123\",\n  \"role\": \"ADMIN\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/sign-up-testing",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "sign-up-testing"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Segurança: Endpoint de teste não deve aceitar cadastro público sem autenticação', function () {",
                  "    pm.expect([401, 403, 404]).to.include(pm.response.code);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST /api/auth/refresh - Sem Refresh Token (400 ou 401)",
          "request": {
