{
  "info": {
    "name": "CTR-PE API - Test & Security Suite",
    "_postman_id": "ctr-pe-api-suite-v1",
    "description": "Suíte completa de testes automatizados de contrato, segurança (RBAC, Multi-Tenancy, Sanitização) e regras de negócio para a API CTR-PE.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00. Health & Core",
      "item": [
        {
          "name": "GET /health - Status OK",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code é 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Contrato de resposta contém status ok e service', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.status).to.eql('ok');",
                  "    pm.expect(json.service).to.eql('ctrpe-api');",
                  "    pm.expect(json).to.have.property('timestamp');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET /api/health - Validação de Rota Alternativa / Erro 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Retorna contrato 200 ou erro 404 padronizado', function () {",
                  "    pm.expect([200, 404]).to.include(pm.response.code);",
                  "    if (pm.response.code === 404) {",
                  "        const json = pm.response.json();",
                  "        pm.expect(json).to.have.property('message');",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01. Auth Router",
      "item": [
        {
          "name": "POST /api/auth/login - ADMIN (Gera token_admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@ctrpe.com.br\",\n  \"senha\": \"Admin@123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login ADMIN responde 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const data = pm.response.json();",
                  "    pm.expect(data).to.have.property('accessToken');",
                  "    pm.environment.set('token_admin', data.accessToken);",
                  "});",
                  "pm.test('Segurança: Resposta não vaza senha ou password_hash', function () {",
                  "    const text = pm.response.text();",
                  "    pm.expect(text).to.not.include('passwordHash');",
                  "    pm.expect(text).to.not.include('password_hash');",
                  "    pm.expect(text).to.not.include('senha');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST /api/auth/login - GESTOR (Gera token_gestor)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"gestor@empresa-a.com.br\",\n  \"senha\": \"Gestor@123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const data = pm.response.json();",
                  "    pm.environment.set('token_gestor', data.accessToken);",
                  "}",
                  "pm.test('Sanitização: Não expõe hash de senha', function () {",
                  "    pm.expect(pm.response.text()).to.not.include('passwordHash');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
