          "name": "POST /api/auth/login - ADMIN (Gera token_admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@ctrpe.com.br\",\n  \"senha\": \"Admin@123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login ADMIN responde 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const data = pm.response.json();",
                  "    pm.expect(data).to.have.property('accessToken');",
                  "    pm.environment.set('token_admin', data.accessToken);",
                  "});",
                  "pm.test('Segurança: Resposta não vaza senha ou password_hash', function () {",
                  "    const text = pm.response.text();",
                  "    pm.expect(text).to.not.include('passwordHash');",
                  "    pm.expect(text).to.not.include('password_hash');",
