EXPO_PUBLIC_API_URL=http://localhost:3333/api

# Variáveis usadas apenas em desenvolvimento, enquanto o login não está implementado.
# Token de acesso válido (obtido em POST /api/auth/sign-in) usado para autenticar as requisições.
EXPO_PUBLIC_DEV_TOKEN=
# Empresa usada por padrão nas telas durante o desenvolvimento.
EXPO_PUBLIC_DEV_EMPRESA_ID=
# Perfil simulado para exibir ações conforme permissão: ADMIN, GESTOR, SUPERVISOR, TECNICO ou CONSULTA.
EXPO_PUBLIC_DEV_PERFIL=ADMIN
